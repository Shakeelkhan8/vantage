APP_NAME=Vantage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production only: the real hostname. Caddy provisions Let's Encrypt for it.
APP_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Host ports the dev stack publishes on. Change if these are already taken.
APP_PORT=8000
VITE_PORT=5173
DB_FORWARD_PORT=5432

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Host is the compose service name, not localhost.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vantage
DB_USERNAME=vantage
DB_PASSWORD=secret

# --- Cache / queue / session ---------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# Bulk scoring runs on the cheap model; only the daily shortlist gets the
# better one. Raise these if you want stronger scoring and can absorb the cost
# — Opus 5 is roughly 5x Haiku.
VANTAGE_SCORING_MODEL=claude-haiku-4-5
VANTAGE_ANALYSIS_MODEL=claude-sonnet-5

# Scoring goes through the Batch API at 50% off. A daily digest has no latency
# requirement, so there is no reason to pay the real-time premium.
VANTAGE_USE_BATCH_API=true

# Hard ceiling. The worker checks spend before dispatching and refuses past it.
VANTAGE_MONTHLY_BUDGET_USD=15

# How many of the day's top jobs get the deeper, more expensive analysis pass.
VANTAGE_DEEP_ANALYSIS_LIMIT=15

# --- Job sources ----------------------------------------------------------
# Greenhouse / Lever / Ashby / Workable board endpoints need no credentials —
# the company watchlist works out of the box. The aggregators below have free
# tiers; leave any of them blank to disable that source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=

# --- Mail -----------------------------------------------------------------
# Outbound digest. Resend's free tier covers 3,000 messages/month.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="vantage@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Inbound job-alert mail. Cloudflare Email Routing posts to the webhook; this
# shared secret is what stops anyone else injecting postings into your inbox.
INBOUND_MAIL_SECRET=

VITE_APP_NAME="${APP_NAME}"
