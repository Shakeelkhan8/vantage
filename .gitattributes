* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Shell scripts must keep LF endings or they break inside the container.
*.sh text eol=lf
docker/entrypoint.sh text eol=lf
